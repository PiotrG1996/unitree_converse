[Unit]
Description=Unitree G1 Voice Conversation Pipeline
After=network-online.target ollama.service
Wants=network-online.target ollama.service
# Never give up restarting.
StartLimitIntervalSec=0

[Service]
Type=simple
User=unitree
WorkingDirectory=/home/unitree/unitree_os/unitree_conversional
Environment="HOME=/home/unitree"
Environment="ROS_DOMAIN_ID=0"
Environment="RMW_IMPLEMENTATION=rmw_cyclonedds_cpp"
Environment="CYCLONEDDS_URI=/home/unitree/cyclonedds_ws/cyclonedds.xml"
Environment="LD_LIBRARY_PATH=/usr/local/lib"
# Wait for eth0 (192.168.123.164) and the CycloneDDS config, then check the
# installed config, Piper binary and both voices before launching.
ExecStartPre=/home/unitree/unitree_os/unitree_conversional/scripts/wait_for_robot_ready.sh 30
ExecStartPre=/usr/bin/test -r /home/unitree/unitree_os/unitree_conversional/install/g1_voice/share/g1_voice/config/voice_params_real.yaml
ExecStartPre=/usr/bin/test -x /home/unitree/.local/piper-bin/piper
ExecStartPre=/usr/bin/test -r /home/unitree/.local/share/piper/en_US-lessac-medium.onnx
ExecStartPre=/usr/bin/test -r /home/unitree/.local/share/piper/pl_PL-gosia-medium/pl_PL-gosia-medium.onnx
ExecStart=/bin/bash -c 'source /opt/ros/foxy/setup.bash && source /home/unitree/cyclonedds_ws/install/setup.bash && source /home/unitree/unitree_ros2/cyclonedds_ws/install/setup.bash && source /home/unitree/unitree_os/unitree_conversional/install/local_setup.bash && exec ros2 launch g1_voice voice_real.launch.py'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
