# Installed to /etc/systemd/system/ollama.service by setup.sh (replaces the
# stock unit written by the Ollama installer).
[Unit]
Description=Ollama Service
After=network-online.target

[Service]
ExecStart=/usr/local/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3
# Keep llama3.2 resident so the first reply after a pause is not delayed.
Environment="OLLAMA_KEEP_ALIVE=-1"
# Short spoken turns + a 6-turn history fit easily; halves the KV cache.
Environment="OLLAMA_CONTEXT_LENGTH=2048"
Environment="PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# An OOM once killed the model runner mid-reply; prefer other victims.
OOMScoreAdjust=-500

[Install]
WantedBy=default.target
